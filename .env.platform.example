# Copy to .env on the deployment machine, then replace the values.
# Never commit .env: Git ignores it.

# Domain of the platform and of the compiled sites
# (*.monl.example.com).
MONL_PLATFORM_DOMAIN=monl.example.com
MONL_PLATFORM_PUBLIC_URL=https://monl.example.com
# Optional: versioned GHCR image published by CI. Without this line,
# Compose builds monl-platform:local on the server.
# With USE_PREBUILT_IMAGE=1, use an exact release tag or a digest,
# never latest.
# MONL_PLATFORM_IMAGE=ghcr.io/bodichane/monl-platform:v0.9.0-beta.8

# The compose file is meant to sit behind a TLS reverse
# proxy.
MONL_COOKIE_SECURE=1
MONL_TRUST_PROXY=1

# OAuth secret only if Google or GitHub is enabled.
# Generate with: openssl rand -hex 32
MONL_PLATFORM_OAUTH_STATE_SECRET=

# Optional: enable an OAuth provider by adding its client id and secret.
# MONL_OAUTH_GITHUB_CLIENT_ID=
# MONL_OAUTH_GITHUB_SECRET=
# MONL_OAUTH_GITHUB_BASE_URL=  # override for a compatible provider
# MONL_OAUTH_GOOGLE_CLIENT_ID=
# MONL_OAUTH_GOOGLE_SECRET=
# MONL_OAUTH_GOOGLE_BASE_URL=  # override for a compatible provider

# Exploitation
MONL_LOG_LEVEL=INFO
MONL_ISOLATE_COMPILES=1
MONL_MAX_CONCURRENT_COMPILES=2
MONL_COMPILE_TIMEOUT_SECONDS=45
MONL_COMPILE_CPU_SECONDS=30
MONL_COMPILE_MEMORY_MB=768
MONL_COMPILE_OUTPUT_MB=64
MONL_PROJECT_RETENTION_DAYS=30
MONL_BACKUP_INTERVAL_SECONDS=86400
# The backup becomes unhealthy after two periods without a valid copy.
MONL_BACKUP_MAX_AGE_SECONDS=172800
