# Copier vers .env sur la machine de déploiement, puis remplacer les valeurs.
# Ne jamais commiter .env : il est ignoré par Git.

# Domaine de la plateforme et des sites compilés (*.monl.example.com).
MONL_PLATFORM_DOMAIN=monl.example.com
MONL_PLATFORM_PUBLIC_URL=https://monl.example.com
# Optionnel : image GHCR versionnée publiée par la CI. Sans cette ligne,
# Compose construit monl-platform:local sur le serveur.
# En mode USE_PREBUILT_IMAGE=1, utiliser un tag de release précis ou un digest,
# jamais latest.
# MONL_PLATFORM_IMAGE=ghcr.io/bodichane/monl-platform:v0.9.0-beta.8

# Le compose est prévu derrière un reverse proxy TLS.
MONL_COOKIE_SECURE=1
MONL_TRUST_PROXY=1

# Secret OAuth uniquement si Google ou GitHub est activé.
# Générer avec : openssl rand -hex 32
MONL_PLATFORM_OAUTH_STATE_SECRET=

# Optionnel : activer un fournisseur OAuth en ajoutant son identifiant et son secret.
# MONL_OAUTH_GITHUB_CLIENT_ID=
# MONL_OAUTH_GITHUB_SECRET=
# MONL_OAUTH_GITHUB_BASE_URL=  # surcharge pour un fournisseur compatible
# MONL_OAUTH_GOOGLE_CLIENT_ID=
# MONL_OAUTH_GOOGLE_SECRET=
# MONL_OAUTH_GOOGLE_BASE_URL=  # surcharge pour un fournisseur compatible

# Exploitation
MONL_LOG_LEVEL=INFO
MONL_ISOLATE_COMPILES=1
MONL_MAX_CONCURRENT_COMPILES=2
MONL_COMPILE_TIMEOUT_SECONDS=45
MONL_COMPILE_CPU_SECONDS=30
MONL_COMPILE_MEMORY_MB=768
MONL_COMPILE_OUTPUT_MB=64
MONL_PROJECT_RETENTION_DAYS=30
MONL_BACKUP_INTERVAL_SECONDS=86400
# La sauvegarde devient unhealthy après deux périodes sans copie valide.
MONL_BACKUP_MAX_AGE_SECONDS=172800
