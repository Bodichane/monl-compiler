# Ignorer les modèles d'IA volumineux
models/*
!models/.gitkeep

# Bytecode Python
__pycache__/
*.pyc

# Secret de signature et base de la démo : régénérés au premier démarrage.
# Le .jwt_secret de la racine était ignoré depuis toujours, celui de demo/
# avait échappé à la règle — et le dépôt est devenu public (point 66).
demo/.jwt_secret
demo/app.db

# Projets compilés localement. Tout ce qui est produit par 'monl' vit dans
# projets/ — un seul dossier à ignorer plutôt qu'une ligne par application,
# et la racine du dépôt cesse de se remplir d'applications au milieu du code
# du compilateur. (demo/ est la démo de référence, suivie exprès :
# test_demo.py et test_design_contract.py s'appuient dessus.)
/projets/

# Rapport de couverture (point 63)
.coverage
htmlcov/

# Graine de variation visuelle : le commentaire de generator/theme.py
# affirmait depuis toujours qu'elle était ignorée — elle ne l'était pas.
.monl_theme_seed

# Artefacts de build du paquet (point 65) et archives locales de bêta
*.egg-info/
archives/
# dist/ est la sortie de `python -m build`, jointe aux releases mais jamais
# versionnée ; build/ sert à setuptools ET au dossier de sortie que le
# démarrage rapide propose (`--output build/...`) — deux artefacts, aucun
# écrit à la main.
/dist/
/build/
