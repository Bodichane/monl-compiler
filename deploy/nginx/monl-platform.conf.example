# Nginx example for monl.example.com and the compiled sites.
# Replace monl.example.com, then obtain the certificate (wildcard included)
# with your host's ACME mechanism before enabling the HTTPS block. A wildcard
# certificate usually requires a DNS challenge.

server {
    listen 80;
    server_name monl.example.com *.monl.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name monl.example.com *.monl.example.com;

    ssl_certificate /etc/letsencrypt/live/monl.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monl.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # This block ALSO serves the compiled sites hosted under *.monl.example.com
    # (server_name above). An `upload max N` rule (in bytes) declared in a spec
    # can go up to 32 MiB (measured in the compiler's suite,
    # tests/test_depot_depuis_le_dialogue.py): a low ceiling here would reject
    # with 413, BEFORE reaching the application, an upload the compiled backend
    # would accept — raise this value if a hosted project declares a higher
    # upload limit.
    client_max_body_size 50m;
    location / {
        proxy_pass http://127.0.0.1:8022;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
