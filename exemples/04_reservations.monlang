app BookMe

entity Professional
    name: String
    specialty: String

entity Slot
    startAt: DateTime
    endAt: DateTime
    isAvailable: Boolean

entity Appointment
    notes: Text
    createdAt: DateTime

relation Professional hasMany Slot
relation Slot hasOne Appointment
relation Client hasMany Appointment

actor Client
actor ProfessionalActor

rule Slot.startAt required

workflow ClientBooking for Client
    Read Slot
    Create Appointment

workflow ProfessionalSchedule for ProfessionalActor
    Create Slot
    Delete Slot
